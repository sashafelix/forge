        "reasoning",
        "structured_output"
      ],
      "targets": [
        "operator-primary",
        "operator-fallback"
      ]
    },
    {
      "id": "refactor-refactorer",
      "stage": "refactor",
      "role": "refactorer",
      "required_model_capabilities": [
        "code_generation",
        "code_review",
        "reasoning",
        "structured_output"
