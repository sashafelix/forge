{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dev-pipeline.local/schemas/evidence-import.schema.json",
  "title": "Forge Evidence Import Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "import_contract", "pack_id", "pack_version", "accepted_bundle_format", "required_artifacts", "event_schema", "profile_schema", "role_schema", "translation_rules", "publication_mode"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "import_contract": {"type": "string", "const": "forge-evidence-import-v1"},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "accepted_bundle_format": {"type": "string", "const": "local-rgr-evidence-bundle/1.0"},
    "required_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "event_schema": {"type": "string", "minLength": 1},
    "profile_schema": {"type": "string", "minLength": 1},
    "role_schema": {"type": "string", "minLength": 1},
    "translation_rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["local", "destination", "rule"], "properties": {"local": {"type": "string", "minLength": 1}, "destination": {"type": "string", "minLength": 1}, "rule": {"type": "string", "minLength": 1}}}},
    "publication_mode": {"type": "string", "const": "none"}
  }
}
