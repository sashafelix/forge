{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/execution-policy.schema.json",
  "title": "Operator execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_paths",
    "test_paths",
    "commands",
    "test_command",
    "test_format",
    "image",
    "max_turns",
    "max_output_bytes",
    "command_timeout"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "test_command": {
      "type": "string",
      "minLength": 1
    },
    "verify_command": {
      "type": "string",
      "minLength": 1
    },
    "test_format": {
      "enum": [
        "unittest",
        "pytest",
        "junit"
      ]
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9._:/-]+@)?sha256:[a-f0-9]{64}$"
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "command_timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "minimum_profile": {
      "enum": [
        "small",
        "standard",
        "high-risk"
      ]
    }
  }
}
